{
  "name": "xp-thermal-service",
  "version": "1.0.0",
  "description": "Production-grade local thermal printing service for restaurant POS",
  "main": "dist/index.js",
  "bin": {
    "xp-thermal": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "cli": "ts-node src/cli.ts",
    "service:install": "node dist/service/installer.js install",
    "service:uninstall": "node dist/service/installer.js uninstall",
    "service:start": "node dist/service/installer.js start",
    "service:stop": "node dist/service/installer.js stop",
    "test": "jest",
    "package": "npm run build && npm run package:win && npm run package:linux && npm run package:zip",
    "package:win": "pkg --config pkg.config.json --targets node22-win-x64 --output bundle/xp-thermal-service.exe dist/index.js",
    "package:linux": "pkg --config pkg.config.json --targets node22-linux-x64 --output bundle/xp-thermal-service-linux dist/index.js",
    "package:zip": "node scripts/package.js",
    "release:r2": "node scripts/release-r2.mjs",
    "qa": "node scripts/deep-qa.js",
    "qa:write": "node scripts/deep-qa.js --write",
    "qa:full": "node scripts/deep-qa.js --write --print",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "thermal-printer",
    "escpos",
    "pos",
    "receipt",
    "restaurant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "qrcode": "^1.5.3",
    "rate-limiter-flexible": "^5.0.0",
    "sql.js": "^1.10.0",
    "uuid": "^9.0.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.16",
    "@types/node-windows": "^0.1.6",
    "@types/qrcode": "^1.5.5",
    "@types/sql.js": "^1.4.10",
    "@types/uuid": "^9.0.8",
    "@yao-pkg/pkg": "6.22.0",
    "jest": "^30.4.2",
    "node-windows": "^1.0.0-beta.8",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "yazl": "^3.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
